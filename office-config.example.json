{
  "cec": {
    "site": "https://example.atlassian.net",
    "cloudId": "configure-locally",
    "board": 0,
    "account": "configure-locally",
    "repo": "/absolute/path/to/azure-repository",
    "organization": "https://dev.azure.com/example",
    "project": "example",
    "repository": "example",
    "repositoryId": "configure-locally",
    "target": "staging"
  },
  "projects": [
    {
      "id": "example",
      "name": "Example GitHub project",
      "provider": "github",
      "repo": "/absolute/path/to/repository",
      "repository": "owner/repository",
      "target": "main",
      "githubProject": {
        "owner": "owner",
        "number": 1,
        "url": "https://github.com/users/owner/projects/1"
      },
      "policy": {
        "merge": "harness",
        "handsOff": true,
        "checkpoint": { "hour": 17, "weekends": true }
      }
    },
    {
      "id": "acme",
      "name": "Example Jira/Azure project",
      "provider": "azure",
      "repo": "/absolute/path/to/second-azure-repository",
      "repository": "example-web",
      "target": "develop",
      "jira": {
        "site": "https://example-team.atlassian.net",
        "cloudId": "configure-locally",
        "account": "configure-locally",
        "projectKey": "ACME",
        "board": 1,
        "twgProfile": "configure-locally",
        "credentialAccount": "configure-locally",
        "statuses": {
          "intake": [{ "name": "To Do", "id": "10000" }]
        }
      },
      "azure": {
        "organization": "https://dev.azure.com/example-team",
        "project": "example-team",
        "repositoryId": "configure-locally",
        "deployment": {
          "subscription": "configure-locally",
          "resourceGroup": "configure-locally",
          "containerApp": "configure-locally",
          "healthy": "http-ok"
        }
      },
      "prompt": {
        "authority": "Replace with this project's own approved authority: what the Office may change, where it may open draft PRs, and what it must never do."
      }
    }
  ],
  "delivery": {
    "concurrency": 3
  },
  "githubApp": {
    "appId": 123456,
    "installationId": 12345678,
    "botLogin": "example-office[bot]",
    "keySource": { "kind": "keychain", "service": "the-office-github-app", "account": "configure-locally" },
    "repositories": {
      "example": { "repository": "owner/repository", "repositoryId": 1 }
    },
    "writes": {
      "example": { "comment": "operator", "issue-create": "operator", "push": "operator" }
    }
  },
  "holds": {}
}
